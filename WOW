-- ToolUtils (תיקון לגרסה עם darken/restore נכונים)
local ToolUtils = {}

function ToolUtils.darkenParts(root, store)
	if not root then return end
	store = store or {}
	-- נמנע דליפת זיכרון על ידי שימוש בטבלת מפתחות חלשה
	setmetatable(store, { __mode = "k" })

	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("BasePart") or desc:IsA("MeshPart") then
			store[desc] = store[desc] or { Color = desc.Color, Material = desc.Material, Transparency = desc.Transparency }
			if desc:IsA("MeshPart") then
				store[desc].TextureID = desc.TextureID
			end
			pcall(function()
				desc.Color = Color3.fromRGB(5, 5, 5)
				desc.Material = Enum.Material.SmoothPlastic
			end)
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			store[desc] = store[desc] or { Transparency = desc.Transparency }
			pcall(function() desc.Transparency = 1 end)
		elseif desc:IsA("SpecialMesh") then
			store[desc] = store[desc] or { TextureId = desc.TextureId }
			pcall(function() desc.TextureId = "" end)
		end
	end

	return store
end

function ToolUtils.restoreParts(store)
	if not store then return end
	for inst, props in pairs(store) do
		if inst and inst.Parent then
			pcall(function()
				if props.Color then inst.Color = props.Color end
				if props.Material then inst.Material = props.Material end
				if props.Transparency then inst.Transparency = props.Transparency end
				if props.TextureID and inst:IsA("MeshPart") then inst.TextureID = props.TextureID end
				if props.TextureId and inst:IsA("SpecialMesh") then inst.TextureId = props.TextureId end
			end)
		end
	end
end

return ToolUtils
