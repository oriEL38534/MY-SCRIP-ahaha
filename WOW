	openButton.Position = UDim2.new(0.5, -40, 0.92, -15)
	openButton.AnchorPoint = Vector2.new(0.5,0.5)
	openButton.BackgroundColor3 = Color3.fromRGB(50,50,50)
	openButton.TextColor3 = Color3.new(1,1,1)
	openButton.Text = "Bow Menu"
	openButton.Parent = screenGui
	openButton.Visible = false

	-- Main menu frame
	menuFrame = Instance.new("Frame")
	menuFrame.Size = UDim2.new(0, 300, 0, 180)
	menuFrame.Position = UDim2.new(0.5, -150, 0.5, -90)
	menuFrame.AnchorPoint = Vector2.new(0.5,0.5)
	menuFrame.BackgroundColor3 = Color3.fromRGB(30,30,30)
	menuFrame.BorderSizePixel = 0
	menuFrame.Visible = false
	menuFrame.Parent = screenGui

	local title = Instance.new("TextLabel", menuFrame)
	title.Size = UDim2.new(1, -20, 0, 28)
	title.Position = UDim2.new(0,10,0,8)
	title.BackgroundTransparency = 1
	title.Text = "תפריט Bow"
	title.TextColor3 = Color3.new(1,1,1)
	title.Font = Enum.Font.SourceSansBold
	title.TextSize = 20

	-- Value label
	valueLabel = Instance.new("TextLabel", menuFrame)
	valueLabel.Size = UDim2.new(1, -20, 0, 22)
	valueLabel.Position = UDim2.new(0,10,0,38)
	valueLabel.BackgroundTransparency = 1
	valueLabel.TextColor3 = Color3.fromRGB(200,200,200)
	valueLabel.Text = "מהירות: 20"
	valueLabel.Font = Enum.Font.SourceSans
	valueLabel.TextSize = 18

	-- Slider bar background
	sliderBar = Instance.new("Frame", menuFrame)
	sliderBar.Size = UDim2.new(1, -40, 0, 28)
	sliderBar.Position = UDim2.new(0,20,0,70)
	sliderBar.BackgroundColor3 = Color3.fromRGB(60,60,60)
	sliderBar.BorderSizePixel = 0
	sliderBar.AnchorPoint = Vector2.new(0,0)

	-- Fill for visual
	local sliderFill = Instance.new("Frame", sliderBar)
	sliderFill.Name = "Fill"
	sliderFill.Size = UDim2.new(0,0,1,0)
	sliderFill.BackgroundColor3 = Color3.fromRGB(100,180,100)
	sliderFill.BorderSizePixel = 0
	sliderFill.Position = UDim2.new(0,0,0,0)

	-- Knob
	sliderKnob = Instance.new("ImageButton", sliderBar)
	sliderKnob.Name = "Knob"
	sliderKnob.Size = UDim2.new(0, 18, 1, -4)
	sliderKnob.Position = UDim2.new(0, -9, 0, 2)
	sliderKnob.AnchorPoint = Vector2.new(0.5,0)
	sliderKnob.BackgroundColor3 = Color3.fromRGB(220,220,220)
	sliderKnob.BorderSizePixel = 0
	sliderKnob.Image = ""
	sliderKnob.AutoButtonColor = false

	-- minus / plus buttons
	minusBtn = Instance.new("TextButton", menuFrame)
	minusBtn.Size = UDim2.new(0, 36, 0, 28)
	minusBtn.Position = UDim2.new(0, 20, 0, 104)
	minusBtn.Text = "-"
	minusBtn.BackgroundColor3 = Color3.fromRGB(80,80,80)
	minusBtn.TextColor3 = Color3.new(1,1,1)

	plusBtn = Instance.new("TextButton", menuFrame)
	plusBtn.Size = UDim2.new(0, 36, 0, 28)
	plusBtn.Position = UDim2.new(1, -56, 0, 104)
	plusBtn.AnchorPoint = Vector2.new(0,0)
	plusBtn.Text = "+"
	plusBtn.BackgroundColor3 = Color3.fromRGB(80,80,80)
	plusBtn.TextColor3 = Color3.new(1,1,1)

	-- inputBox for direct number
	inputBox = Instance.new("TextBox", menuFrame)
	inputBox.Size = UDim2.new(0, 160, 0, 28)
	inputBox.Position = UDim2.new(0.5, -80, 0, 104)
	inputBox.AnchorPoint = Vector2.new(0.5,0)
	inputBox.Text = ""
	inputBox.PlaceholderText = tostring(MIN_SPEED .. "-" .. MAX_SPEED)
	inputBox.BackgroundColor3 = Color3.fromRGB(50,50,50)
	inputBox.TextColor3 = Color3.new(1,1,1)
	inputBox.ClearTextOnFocus = false

	-- Apply / Close
	applyButton = Instance.new("TextButton", menuFrame)
	applyButton.Size = UDim2.new(0, 120, 0, 32)
	applyButton.Position = UDim2.new(0.5, -130, 1, -40)
	applyButton.AnchorPoint = Vector2.new(0,1)
	applyButton.Text = "החל"
	applyButton.BackgroundColor3 = Color3.fromRGB(80,140,80)
	applyButton.TextColor3 = Color3.new(1,1,1)

	closeButton = Instance.new("TextButton", menuFrame)
	closeButton.Size = UDim2.new(0, 120, 0, 32)
	closeButton.Position = UDim2.new(0.5, 10, 1, -40)
	closeButton.AnchorPoint = Vector2.new(0,1)
	closeButton.Text = "סגור"
	closeButton.BackgroundColor3 = Color3.fromRGB(140,80,80)
	closeButton.TextColor3 = Color3.new(1,1,1)

	-- מאפייני עזר
	local function setSliderBySpeed(speed)
		local ratio = speedToPosition(speed)
		local totalWidth = sliderBar.AbsoluteSize.X
		local knobX = ratio * totalWidth
		-- עדכון מיקום knob ו-fill
		sliderKnob.Position = UDim2.new(ratio, 0, 0, 2)
		sliderBar:FindFirstChild("Fill").Size = UDim2.new(ratio, 0, 1, 0)
		valueLabel.Text = "מהירות: " .. tostring(speed)
		inputBox.Text = tostring(speed)
	end

	-- הפעל הקשרים
	local function onOpenClicked()
		menuFrame.Visible = true
	end
	openButton.MouseButton1Click:Connect(onOpenClicked)

	closeButton.MouseButton1Click:Connect(function()
		menuFrame.Visible = false
	end)

	applyButton.MouseButton1Click:Connect(function()
		local val = clamp(tonumber(inputBox.Text) or positionToSpeed(sliderKnob.Position.X.Scale))
		-- שלח בקשה לשרת
		local evt = getEvent()
		if evt then
			evt:FireServer(val)
		end
		-- עדכון מקומי של התצוגה
		setSliderBySpeed(val)
	end)

	minusBtn.MouseButton1Click:Connect(function()
		local cur = clamp(tonumber(inputBox.Text) or positionToSpeed(sliderKnob.Position.X.Scale))
		cur = clamp(cur - 1)
		setSliderBySpeed(cur)
	end)

	plusBtn.MouseButton1Click:Connect(function()
		local cur = clamp(tonumber(inputBox.Text) or positionToSpeed(sliderKnob.Position.X.Scale))
		cur = clamp(cur + 1)
		setSliderBySpeed(cur)
	end)

	-- סליידר: טיפול בגרירה
	local function updateFromPixel(x)
		local absPos = sliderBar.AbsolutePosition.X
		local width = sliderBar.AbsoluteSize.X
		local relative = (x - absPos) / width
		local speed = positionToSpeed(relative)
		setSliderBySpeed(speed)
	end

	sliderKnob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			UserInputService.InputChanged:Connect(function(inp)
				if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
					updateFromPixel(inp.Position.X)
				elseif dragging and inp.UserInputType == Enum.UserInputType.Touch then
					updateFromPixel(inp.Position.X)
				end
			end)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- גם קליק על ה-bar מעדכן
	sliderBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			updateFromPixel(input.Position.X)
		end
	end)

	-- הקלקה על ה-knob תופסת גרירה דרך MouseMovement handled למעלה

	-- עדכון התחלי לערך הנוכחי מה־Attribute
	local initial = clamp(tool:GetAttribute("WalkSpeed") or 20)
	setSliderBySpeed(initial)
end

local function destroyGui()
	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end
end

-- הצגה של OpenButton רק כשהשחקן המחזיק הוא אתה
tool.Equipped:Connect(function()
	if tool.Name ~= BOW_NAME then return end
	if not player.Character then return end
	if tool.Parent ~= player.Character then return end

	-- חשוך את הכלי
	darkenParts(tool)

	-- צור GUI והצג הכפתור הקטן + פתח אוטומטי אם רוצים
	createGui()
	if openButton then openButton.Visible = true end
end)

tool.Unequipped:Connect(function()
	if tool.Name ~= BOW_NAME then return end
	restoreParts()
	if openButton then openButton.Visible = false end
	if menuFrame then menuFrame.Visible = false end
end)

-- מקש M לפתיחה/סגירה של התפריט (רק כשלוחש ה‑Bow הוא המחזיק)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.M then
		-- רק אם מצויד
		if tool.Parent and tool.Parent:IsDescendantOf(player.Character) then
			-- בטל/הצג
			if menuFrame and menuFrame.Visible then
				menuFrame.Visible = false
			else
				if not screenGui then createGui() end
				if menuFrame then menuFrame.Visible = true end
			end
		end
	end
end)

-- עדכון GUI כש‑Attribute משתנה (שרת עדכן את ה־Attribute)
tool:GetAttributeChangedSignal("WalkSpeed"):Connect(function()
	if screenGui and menuFrame and menuFrame.Visible then
		-- עדכון סליידר/טקסט אם פתוח
		local v = clamp(tool:GetAttribute("WalkSpeed") or 20)
		-- מחפש פונקציה setSliderBySpeed - היא מוגדרת בתוך createGui; נשתמש בדרך פחות אלגנטית:
		-- פשוט עדכון השדות הישירות אם קיימים
		if valueLabel then valueLabel.Text = "מהירות: " .. tostring(v) end
		if inputBox then inputBox.Text = tostring(v) end
		if sliderBar and sliderBar:FindFirstChild("Fill") and sliderKnob then
			local ratio = speedToPosition(v)
			sliderBar:FindFirstChild("Fill").Size = UDim2.new(ratio,0,1,0)
			sliderKnob.Position = UDim2.new(ratio, 0, 0, 2)
		end
	end
end)
