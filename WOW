-- LocalScript (Client) — לשים בתוך ה-Tool
-- תפריט עם סליידר (16-200), כפתור Apply, כפתור Close, ופתח מהיר (כפתור קטן / מקש M)
local tool = script.Parent
local BOW_NAME = "Bow" -- שנה אם צריך
local MIN_SPEED = 16
local MAX_SPEED = 200
local EVENT_NAME = "WalkSpeedChangeEvent"

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ויזואל: חשיכה
local DARK_COLOR = Color3.fromRGB(5,5,5)
local DARK_MATERIAL = Enum.Material.SmoothPlastic
local originalProps = {}

local function storeIfMissing(inst, props)
	if originalProps[inst] then return end
	originalProps[inst] = props
end

local function darkenParts(root)
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("BasePart") or desc:IsA("MeshPart") then
			local props = {Color = desc.Color, Material = desc.Material, Transparency = desc.Transparency}
			if desc:IsA("MeshPart") then props.TextureID = desc.TextureID end
			storeIfMissing(desc, props)
			desc.Color = DARK_COLOR
			desc.Material = DARK_MATERIAL
		end
		if desc:IsA("Decal") or desc:IsA("Texture") then
			storeIfMissing(desc, {Transparency = desc.Transparency})
			desc.Transparency = 1
		end
		if desc:IsA("SpecialMesh") then
			storeIfMissing(desc, {TextureId = desc.TextureId})
			pcall(function() desc.TextureId = "" end)
		end
	end
end

local function restoreParts()
	for inst, props in pairs(originalProps) do
		if inst and inst.Parent then
			pcall(function()
				if props.Color then inst.Color = props.Color end
				if props.Material then inst.Material = props.Material end
				if props.Transparency then inst.Transparency = props.Transparency end
				if props.TextureID and inst:IsA("MeshPart") then inst.TextureID = props.TextureID end
				if props.TextureId and inst:IsA("SpecialMesh") then inst.TextureId = props.TextureId end
			end)
		end
	end
	originalProps = {}
end

-- RemoteEvent reference (נמצא על ה-Tool לפי הסקריפט של השרת)
local function getEvent()
	local evt = tool:FindFirstChild(EVENT_NAME)
	if evt and evt:IsA("RemoteEvent") then return evt end
	return nil
end

-- GUI משתנה
local screenGui, menuFrame, openButton
local sliderBar, sliderKnob, valueLabel, applyButton, closeButton, minusBtn, plusBtn, inputBox

local dragging = false
local dragConnection

local function clamp(v)
	v = tonumber(v) or MIN_SPEED
	v = math.floor(v)
	if v < MIN_SPEED then v = MIN_SPEED end
	if v > MAX_SPEED then v = MAX_SPEED end
	return v
end

local function speedToPosition(speed)
	local ratio = (speed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
	ratio = math.clamp(ratio,0,1)
	return ratio
end

local function positionToSpeed(ratio)
	ratio = math.clamp(ratio,0,1)
	local speed = MIN_SPEED + ratio * (MAX_SPEED - MIN_SPEED)
	return math.floor(speed + 0.5)
end

local function createGui()
	if screenGui then return end
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BowMenuGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	-- Open small button (על המסך) שיופיע רק כשהמחזיק הוא אתה
	openButton = Instance.new("TextButton")
